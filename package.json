{
  "name": "wsl2-linux-essentials-book",
  "version": "2.0.1",
  "description": "illustrated-linux-basics-book の次のステップとして、WSL2 上で実践的な Linux スキルを習得するための技術書",
  "author": "株式会社アイティードゥ",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "build": "jekyll build --source docs --destination _site",
    "serve": "jekyll serve --source docs --destination _site --livereload",
    "deploy": "npm run build && gh-pages -d _site",
    "deploy-setup": "gh-pages-clean",
    "validate-deploy": "node scripts/validate-github-pages.js",
    "pages-status": "node scripts/check-pages-status.js",
    "check:metadata": "python3 scripts/check_metadata_consistency.py",
    "check:cron-service": "python3 scripts/check_cron_service_contract.py --self-test && python3 scripts/check_cron_service_contract.py",
    "check:security": "npm audit --omit=optional",
    "test": "npm run check:metadata && npm run check:cron-service && npm run check:security"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itdojp/wsl2-linux-essentials-book.git"
  },
  "homepage": "https://itdojp.github.io/wsl2-linux-essentials-book/",
  "bugs": {
    "url": "https://github.com/itdojp/wsl2-linux-essentials-book/issues"
  }
}
